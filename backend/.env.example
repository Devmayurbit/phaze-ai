# ============================================
# Phase 1: Real Instagram & AI Content Setup
# ============================================
# Copy this file to .env and fill in your keys

# Backend Server
PORT=5000
NODE_ENV=development

# ============================================
# REQUIRED: Instagram Scraping (Phase 1)
# ============================================
# Get from: https://rapidapi.com/marketplace/search/instagram
# Choose a free/paid plan, copy API key here
RAPIDAPI_KEY=your_rapidapi_key_here

# ============================================
# REQUIRED: AI Content Generation (Phase 1)
# ============================================
# Get from: https://huggingface.co/settings/tokens
# 1. Create account on HuggingFace.co
# 2. Go to Settings > Access Tokens
# 3. Create token with "Read" access
# 4. Copy below
HUGGINGFACE_API_KEY=hf_your_token_here

# ============================================
# Frontend Configuration
# ============================================
VITE_API_URL=http://localhost:5000/api

# ============================================
# Debugging (Phase 1)
# ============================================
# Set to 'true' to see detailed scraper logs
DEBUG_SCRAPER=false

# ============================================
# Phase 2+ Database (Optional)
# ============================================
# MONGODB_URI=mongodb://localhost:27017/phaze-ai
# DB_HOST=localhost
# DB_PORT=27017
# DB_NAME=phaze-ai

# ============================================
# Phase 2+ Authentication (Optional)
# ============================================
# JWT_SECRET=your_jwt_secret_key

# CORS
CORS_ORIGIN=http://localhost:5173
