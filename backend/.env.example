PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas - FREE tier)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/phaze-ai

# AI - Primary (Google Gemini Flash - FREE 1M tokens/day)
GEMINI_API_KEY=your_gemini_api_key

# AI - Fallback (HuggingFace - FREE)
HUGGINGFACE_API_KEY=your_hf_key

# AI - Emergency Fallback (OpenAI - paid, use sparingly)
OPENAI_API_KEY=your_openai_key

# Instagram Scraping (RapidAPI)
RAPIDAPI_KEY=your_rapidapi_key

# JWT Auth
JWT_SECRET=change-this-to-a-random-string
JWT_REFRESH_SECRET=change-this-to-another-random-string
