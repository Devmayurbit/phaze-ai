# ==========================================
# PHAZE AI - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git - it contains secrets!

# ==========================================
# Backend Configuration
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# Database - MongoDB
# ==========================================
# Local development (no credentials)
MONGODB_URI=mongodb://localhost:27017/phaze-ai

# OR Cloud Atlas (requires credentials)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/phaze-ai?appName=Cluster0

DB_HOST=localhost
DB_PORT=27017
DB_NAME=phaze-ai

# ==========================================
# Frontend
# ==========================================
VITE_API_URL=http://localhost:5000/api

# ==========================================
# External API Keys (Future Use)
# ==========================================
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Get from: https://rapidapi.com/dashboard
RAPIDAPI_KEY=

# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ==========================================
# n8n Webhook (Future Integration)
# ==========================================
N8N_WEBHOOK_URL=https://n8n.example.com

# ==========================================
# JWT Authentication (Future)
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# ==========================================
# CORS Configuration
# ==========================================
CORS_ORIGIN=http://localhost:5173

